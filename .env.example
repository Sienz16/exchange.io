# Required for historical data, forecasts, persistence, and admin telemetry.
DATABASE_URL=postgres://exchange_io:change-me@localhost:5432/exchange_io

# Optional daily refresh base. ECB reference storage remains EUR-only.
DAILY_RATE_BASE=EUR

# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Use a separate random value for telemetry IP hashes.
ANALYTICS_SALT=

NODE_ENV=development
PORT=5173

# Optional JSON webhook for daily ingest failure alerts.
ALERT_WEBHOOK_URL=
