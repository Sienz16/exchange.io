{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exchange-io",
  "main": "./dist/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Daily refresh at 00:30 UTC, after open.er-api.com publishes its ~00:00 UTC update.
  // The handler is the `scheduled` export in app/server.ts.
  "triggers": {
    "crons": ["30 0 * * *"]
  },
  "assets": {
    "directory": "./dist"
  }
  // Production secrets (never commit these):
  //   wrangler secret put DATABASE_URL
  // Local `wrangler dev` reads them from .dev.vars (see .dev.vars.example).
}