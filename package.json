{
  "name": "exchange-io",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "start": "bun dist/index.js",
    "build:worker": "vite build --mode client && DEPLOY_TARGET=cloudflare-workers vite build",
    "preview:worker": "bun run build:worker && wrangler dev",
    "deploy:worker": "bun run build:worker && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "bun run scripts/self-check.ts && bun run scripts/forecast-self-check.ts && bun run scripts/task-4-self-check.ts && bun run scripts/task-5-self-check.ts && bun run scripts/api-self-check.ts && bun run scripts/admin-self-check.ts && bun run scripts/hardening-self-check.ts && bun test scripts/*.test.ts"
  },
  "private": true,
  "dependencies": {
    "@hono/react-renderer": "^1.0.1",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.2",
    "honox": "0.1.60",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
